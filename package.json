{
  "name": "space-war",
  "description": "Space War: Orbital Survivor, un roguelite arcade spaziale fatto con Phaser 4 e Vite.",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elpiu/space-war.git"
  },
  "author": "Elpiu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Elpiu/space-war/issues"
  },
  "homepage": "https://elpiu.github.io/space-war/",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "tsc --noEmit && vite build --config vite/config.prod.mjs",
    "preview": "vite preview --config vite/config.prod.mjs",
    "typecheck": "tsc --noEmit",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "phaser": "4.0.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  }
}
